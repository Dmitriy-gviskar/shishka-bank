{
  "backupRoot": "/var/backups/shishka",
  "appDir": "/opt/shishka/current",
  "uploadsDir": "/opt/shishka/shared/uploads",
  "gitRepo": "/root/shishka-backups",
  "pgService": "shishka-backup-source",
  "restoreService": "shishka-restore-validation",
  "expectedDatabase": "REPLACE_WITH_VERIFIED_DATABASE",
  "gpgRecipient": "REPLACE_WITH_BACKUP_PUBLIC_KEY_FINGERPRINT",
  "offsiteHost": "root@REPLACE_WITH_VERIFIED_OFFSITE_HOST",
  "offsiteRoot": "/root/shishka-offsite",
  "configPaths": [
    "/etc/systemd/system/shishka.service",
    "/etc/nginx/sites-available/shishka",
    "/root/shishka-app.env"
  ],
  "sourceFailureDomain": "REPLACE_VPS_PROVIDER",
  "offsiteFailureDomain": "REPLACE_INDEPENDENT_SSH_PROVIDER",
  "s3": {
    "provider": "selectel",
    "failureDomain": "selectel",
    "endpoint": "https://REPLACE_WITH_ENDPOINT_FROM_SELECTEL_PANEL",
    "bucket": "replace-with-private-bucket",
    "region": "REPLACE_WITH_REGION_FROM_PANEL",
    "profile": "shishka-backup",
    "credentialsFile": "/root/.aws/shishka-credentials",
    "configFile": "/root/.aws/shishka-config",
    "prefix": "shishka/snapshots"
  }
}
